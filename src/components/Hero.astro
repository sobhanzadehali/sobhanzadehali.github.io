---
---
<section id="top" class="relative min-h-screen flex items-center pt-28 pb-24 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="glow glow-cyan"></div>
    <div class="glow glow-emerald"></div>
  </div>

  <div class="mx-auto max-w-5xl px-6 w-full">
    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-16 items-center">

      <!-- Left -->
      <div>
        <div
          data-reveal
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3 py-1.5 mb-8"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald opacity-60"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald"></span>
          </span>
          <span class="font-mono text-[11px] text-muted">available for backend work</span>
        </div>

        <h1
          data-reveal
          style="--d:80ms"
          class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05]"
        >
          Sobhan<br />
          <span class="bg-gradient-to-r from-cyan to-emerald bg-clip-text text-transparent">
            Zadehali
          </span>
        </h1>

        <p data-reveal style="--d:160ms" class="mt-6 font-mono text-sm text-cyan">
          Backend Developer
        </p>

        <p data-reveal style="--d:240ms" class="mt-4 text-lg text-muted max-w-lg leading-relaxed">
          Building backend services and AI-powered systems with Python and Go.
        </p>

        <div data-reveal style="--d:320ms" class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="group inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-cyan to-emerald px-5 py-2.5 text-sm font-medium text-bg hover:opacity-90 transition-opacity"
          >
            View Work
            <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>
          <a
            href="https://github.com/sobhanzadehali"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface/50 px-5 py-2.5 text-sm text-muted hover:text-ink hover:border-cyan/40 transition-colors"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a
            href="https://linkedin.com/in/sobhan-zadehali"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface/50 px-5 py-2.5 text-sm text-muted hover:text-ink hover:border-cyan/40 transition-colors"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Right: terminal -->
      <div data-reveal style="--d:400ms" class="hidden lg:block">
        <div
          data-terminal
          class="rounded-xl border border-line bg-surface/70 backdrop-blur-sm overflow-hidden shadow-2xl shadow-black/50"
        >
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-line bg-surface2/60">
            <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
            <span class="ml-3 font-mono text-[10px] text-faint">sobhan@dev ~ %</span>
          </div>
          <div class="term-body p-5 font-mono text-[13px] leading-relaxed space-y-1.5 min-h-[170px]">
            <div class="term-line text-ink" data-text="$ whoami"></div>
            <div class="term-line text-cyan" data-text="> backend_developer"></div>
            <div class="term-line text-ink" data-text="$ cat stack.txt"></div>
            <div class="term-line text-emerald" data-text="> python · go · langchain"></div>
            <div class="term-line text-ink" data-text="$ uptime"></div>
            <div class="term-line text-muted" data-text="> 2+ years, still shipping"></div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 font-mono text-[10px] tracking-widest text-faint hover:text-cyan transition-colors"
    aria-label="Scroll to About"
  >
    SCROLL
    <span class="block h-8 w-px bg-gradient-to-b from-faint to-transparent"></span>
  </a>
</section>