---
const groups = [
  { label: 'Languages', items: ['Python', 'Go', 'Java'] },
  { label: 'Frameworks', items: ['Django', 'Django REST Framework', 'FastAPI', 'Flask'] },
  { label: 'AI / LLM', items: ['LangChain', 'LangGraph', 'RAG', 'Agentic Systems'] },
  { label: 'Data & Infra', items: ['PostgreSQL', 'Redis', 'Celery', 'Docker'] },
  { label: 'Tools', items: ['Git', 'Linux'] },
];
---
<section id="skills" class="relative py-28 sm:py-36">
  <div class="mx-auto max-w-5xl px-6">
    <div data-reveal class="mb-14">
      <span class="font-mono text-xs tracking-[0.2em] text-cyan">04</span>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight mt-2">Stack</h2>
      <div class="mt-5 h-px w-16 bg-gradient-to-r from-cyan to-emerald"></div>
    </div>

    <div class="space-y-9">
      {groups.map((g, i) => (
        <div data-reveal style={`--d:${i * 80}ms`} class="grid sm:grid-cols-[160px_1fr] gap-3 sm:gap-6 items-start">
          <div class="font-mono text-xs text-faint pt-1.5 tracking-wide">{g.label}</div>
          <div class="flex flex-wrap gap-2">
            {g.items.map((item) => (
              <span class="rounded-md border border-line bg-surface/60 px-3 py-1.5 text-xs font-mono text-muted transition-colors hover:border-cyan/40 hover:text-cyan">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>