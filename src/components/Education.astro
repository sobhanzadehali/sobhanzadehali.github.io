<section id="education" class="relative py-28 sm:py-36">
  <div class="mx-auto max-w-5xl px-6">
    <div data-reveal class="mb-14">
      <span class="font-mono text-xs tracking-[0.2em] text-cyan">05</span>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight mt-2">Education</h2>
      <div class="mt-5 h-px w-16 bg-gradient-to-r from-cyan to-emerald"></div>
    </div>

    <article
      data-reveal
      class="relative rounded-2xl border border-line bg-surface/50 p-7 sm:p-9 overflow-hidden"
    >
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald/40 to-transparent"></div>

      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h3 class="font-display text-xl font-semibold">
            M.Sc. Computer Science — Algorithms
          </h3>
          <p class="mt-1 text-sm text-cyan">Shahid Beheshti University</p>
        </div>
        <span class="font-mono text-xs text-faint">2024 — 2026</span>
      </div>

      <p class="mt-5 font-mono text-xs text-faint">Tehran, Iran</p>
    </article>
  </div>
</section>